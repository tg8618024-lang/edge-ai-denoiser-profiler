# Multi-Stage Production Dockerfile for Real-Time Edge AI Audio Pipeline
# Architectures supported: linux/arm64 (Raspberry Pi 4/5, NVIDIA Jetson) & linux/amd64

FROM python:3.11-slim as builder

WORKDIR /build

# Install system audio and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

# Pre-install Python wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Final minimal edge deployment image
FROM python:3.11-slim

LABEL maintainer="DeepMind Systems Engineering Team"
LABEL description="Real-Time Edge AI Audio Denoiser & Latency Profiler"

WORKDIR /app

# Install minimal runtime audio library and healthcheck utility
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy project source and pre-quantized ONNX models
COPY src/ ./src/
COPY models/ ./models/
COPY run_dashboard.py evaluate.py ./

# Healthcheck checking /api/status endpoint
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/status || exit 1

EXPOSE 8000

# Default entrypoint starts the dashboard server
ENTRYPOINT ["python", "run_dashboard.py", "--host", "0.0.0.0", "--port", "8000"]
