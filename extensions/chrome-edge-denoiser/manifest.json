{
  "manifest_version": 3,
  "name": "Edge AI Audio Denoiser & Studio Mic Bridge",
  "version": "1.0.0",
  "description": "Ultra-low latency neural speech enhancement & RTX Voice filter for Google Meet, Discord, and Zoom Web.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Edge AI Audio Denoiser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://discord.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["scripts/content_script.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/webrtc_shim.js",
        "scripts/denoiser-worklet.js"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://discord.com/*",
        "https://*.zoom.us/*"
      ]
    }
  ]
}
